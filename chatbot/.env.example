# Copy this file to `.env` and fill in your key.
# Get one at https://console.groq.com/keys
GROQ_API_KEY=

# --- LLM -------------------------------------------------------------------
# gpt-oss-120b: best free model on Groq (~500 tok/s, 131K context)
# gpt-oss-20b: faster (~1000 tok/s) but lower quality
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TEMPERATURE=0.7
# low | medium | high
GROQ_REASONING_EFFORT=low
GROQ_MAX_RETRIES=2
LLM_TIMEOUT_SECONDS=30

# --- Application -----------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000
API_V1_PREFIX=/fastapi/v1

# --- Conversation ----------------------------------------------------------
CHAT_HISTORY_LIMIT=20
